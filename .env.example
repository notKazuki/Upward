# Supabase — copy this file to ".env.local" and fill in your project's values.
# Find both at: Supabase dashboard → Project Settings → API
#   Project URL        -> NEXT_PUBLIC_SUPABASE_URL
#   anon / public key  -> NEXT_PUBLIC_SUPABASE_ANON_KEY
# These two are safe to expose to the browser. NEVER put the service_role key here.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional — turns the AI coach on. SERVER-ONLY: put it in .env.local (local)
# and Vercel (production). Never commit a real value and never prefix it with
# NEXT_PUBLIC — that would ship your key to the browser.
# Get one at: https://console.anthropic.com → API keys
# Without it the coach still gives its deterministic daily brief, but the chat
# and Pro "Smart Log" stay dormant ("coming soon").
# ANTHROPIC_API_KEY=

# Optional — enables the "Delete account" feature. SERVER-ONLY: put it in
# .env.local (local) and Vercel (production). Never commit a real value and
# never prefix it with NEXT_PUBLIC. Supabase dashboard → Project Settings →
# API → service_role key. Without it, export still works and deletion is hidden.
# SUPABASE_SERVICE_ROLE_KEY=
